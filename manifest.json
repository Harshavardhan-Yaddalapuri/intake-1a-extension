{
  "manifest_version": 3,
  "name": "Intake 1a - eSource Build Agent",
  "version": "0.2.0",
  "description": "Builds a clinical study in an unknown eSource form designer via accessibility-tree perception and a human gate.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Intake 1a Build Agent"
  }
}